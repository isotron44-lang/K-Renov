/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self' https://static.cloudflareinsights.com; connect-src 'self' https://formspree.io https://*.sibforms.com https://cloudflareinsights.com; form-action 'self' https://formspree.io https://*.sibforms.com; frame-ancestors 'self'; base-uri 'self'

/couvertures/*
  Cache-Control: public, max-age=604800

/og/*
  Cache-Control: public, max-age=604800

/pdf/*
  Cache-Control: public, max-age=86400
